// Leave blank to display a placeholder.
// ======================================

const VIDEO_LINKS = {

    video1: "",  // Activity 01 - LED interfacing

    video2: "",  // Activities 02 & 03 - Bluetooth

    video3: ""   // Activities 04 & 05 - Ultrasonic sensor

};


// ======================================
// SLIDE NAVIGATION
// ======================================

const slides = document.querySelectorAll(".slide");

const dotsContainer = document.querySelector(".page-dots");

const pageCount = document.getElementById("pageCount");

let current = 0;


// Create navigation dots

slides.forEach((slide, index) => {

    const dot = document.createElement("button");

    dot.setAttribute(
        "aria-label",
        `Go to page ${index + 1}`
    );

    dot.addEventListener("click", () => {

        showSlide(index);

    });

    dotsContainer.appendChild(dot);

});

const dots = dotsContainer.querySelectorAll("button");


// ======================================
// SHOW SLIDE FUNCTION
// ======================================

function showSlide(index) {

    current = (index + slides.length) % slides.length;

    slides.forEach((slide, i) => {

        slide.classList.toggle(
            "active",
            i === current
        );

    });

    dots.forEach((dot, i) => {

        dot.classList.toggle(
            "active",
            i === current
        );

    });

    pageCount.textContent =
        `${String(current + 1).padStart(2, "0")} / ` +
        `${String(slides.length).padStart(2, "0")}`;

}


// ======================================
// NEXT AND PREVIOUS BUTTONS
// ======================================

document
    .getElementById("prevBtn")
    .addEventListener("click", () => {

        showSlide(current - 1);

    });


document
    .getElementById("nextBtn")
    .addEventListener("click", () => {

        showSlide(current + 1);

    });


// ======================================
// KEYBOARD NAVIGATION
// ======================================

document.addEventListener("keydown", (event) => {

    if (event.key === "ArrowRight") {

        showSlide(current + 1);

    }

    if (event.key === "ArrowLeft") {

        showSlide(current - 1);

    }

});


// ======================================
// VIDEO LINK SETUP
// ======================================

document
    .querySelectorAll(".media-frame")
    .forEach((frame) => {

        const key = frame.dataset.video;

        const url = VIDEO_LINKS[key];

        const video = frame.querySelector("video");


        // If a video link exists

        if (url && url.trim() !== "") {

            video.src = url.trim();

            frame.classList.add("has-video");

        }

    });


// ======================================
// INITIALIZE WEBSITE
// ======================================

showSlide(0);
